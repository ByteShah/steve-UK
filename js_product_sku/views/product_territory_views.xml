<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_territory_view_list" model="ir.ui.view">
        <field name="name">product.territory.list</field>
        <field name="model">product.territory</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="product_territory_view_search" model="ir.ui.view">
        <field name="name">product.territory.search</field>
        <field name="model">product.territory</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('code', 'ilike', self), ('name', 'ilike', self)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="product_territory_action" model="ir.actions.act_window">
        <field name="name">Territories</field>
        <field name="res_model">product.territory</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="product_territory_menu" action="product_territory_action"
        parent="stock.menu_product_in_config_stock" sequence="3"/>
</odoo>
