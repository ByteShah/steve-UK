<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_shopify_sync_products" model="ir.cron">
        <field name="name">Shopify: update changed products</field>
        <field name="model_id" ref="model_shopify_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_products()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
    </record>

    <record id="ir_cron_shopify_sync_stock" model="ir.cron">
        <field name="name">Shopify: send stock changes</field>
        <field name="model_id" ref="model_shopify_store"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_stock()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
