<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_variant_easy_edit_view" model="ir.ui.view">
        <field name="name">product.product.easy.edit.shopify</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <group name="codes" position="inside">
                <field name="shopify_variant_id" invisible="not shopify_variant_id"/>
                <field name="shopify_inventory_item_id" invisible="not shopify_inventory_item_id"/>
            </group>
        </field>
    </record>

    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.form.shopify</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="shopify_variant_id" invisible="not shopify_variant_id"/>
                <field name="shopify_inventory_item_id" invisible="not shopify_inventory_item_id"/>
            </xpath>
        </field>
    </record>

    <record id="product_product_tree_view" model="ir.ui.view">
        <field name="name">product.product.list.shopify</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="shopify_variant_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
