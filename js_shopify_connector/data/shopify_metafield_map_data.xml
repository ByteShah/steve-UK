<?xml version="1.0" encoding="utf-8"?>
<!-- Keys match the metafield definitions the Shopify partner created. Change a key here (or in
     Sales > Configuration > Shopify > Metafields) if theirs changes. -->
<odoo noupdate="1">
    <record id="metafield_width" model="shopify.metafield.map">
        <field name="sequence">10</field>
        <field name="field_id" ref="field_product_template__width"/>
        <field name="key">width</field>
        <field name="metafield_type">number_decimal</field>
        <field name="note">Width in cm</field>
    </record>
    <record id="metafield_depth" model="shopify.metafield.map">
        <field name="sequence">11</field>
        <field name="field_id" ref="field_product_template__depth"/>
        <field name="key">depth</field>
        <field name="metafield_type">number_decimal</field>
        <field name="note">Depth in cm</field>
    </record>
    <record id="metafield_height" model="shopify.metafield.map">
        <field name="sequence">12</field>
        <field name="field_id" ref="field_product_template__height"/>
        <field name="key">height</field>
        <field name="metafield_type">number_decimal</field>
        <field name="note">Height in cm</field>
    </record>
    <record id="metafield_materials" model="shopify.metafield.map">
        <field name="sequence">20</field>
        <field name="field_id" ref="field_product_template__materials"/>
        <field name="key">materials</field>
        <field name="metafield_type">single_line_text_field</field>
        <field name="note">Product Materials</field>
    </record>
    <record id="metafield_care_instructions" model="shopify.metafield.map">
        <field name="sequence">21</field>
        <field name="field_id" ref="field_product_template__care_instructions"/>
        <field name="key">care_instructions</field>
        <field name="metafield_type">multi_line_text_field</field>
        <field name="note">Care Instructions</field>
    </record>
    <record id="metafield_enable_age_safety" model="shopify.metafield.map">
        <field name="sequence">29</field>
        <field name="field_id" ref="field_product_template__enable_age_safety"/>
        <field name="key">enable_age_safety</field>
        <field name="metafield_type">boolean</field>
        <field name="note">Enable Age &amp; Safety</field>
    </record>
    <record id="metafield_age_safety" model="shopify.metafield.map">
        <field name="sequence">30</field>
        <field name="field_id" ref="field_product_template__age_safety_text"/>
        <field name="condition_field_id" ref="field_product_template__enable_age_safety"/>
        <field name="key">age_suitability</field>
        <field name="metafield_type">single_line_text_field</field>
        <field name="note">Age Suitability</field>
    </record>
    <record id="metafield_gpsr_manufacturer" model="shopify.metafield.map">
        <field name="sequence">31</field>
        <field name="field_id" ref="field_product_template__gpsr_manufacturer_id"/>
        <field name="key">gpsr_manufacturer_name</field>
        <field name="metafield_type">single_line_text_field</field>
        <field name="partner_part">name</field>
        <field name="note">GPSR Manufacturer Name</field>
    </record>
    <record id="metafield_gpsr_manufacturer_address" model="shopify.metafield.map">
        <field name="sequence">32</field>
        <field name="field_id" ref="field_product_template__gpsr_manufacturer_id"/>
        <field name="key">gpsr_manufacturer_address</field>
        <field name="metafield_type">multi_line_text_field</field>
        <field name="partner_part">address</field>
        <field name="note">Manufacturer Address</field>
    </record>
    <record id="metafield_gpsr_manufacturer_contact" model="shopify.metafield.map">
        <field name="sequence">33</field>
        <field name="field_id" ref="field_product_template__gpsr_manufacturer_id"/>
        <field name="key">gpsr_manufacturer_electronic_address</field>
        <field name="metafield_type">single_line_text_field</field>
        <field name="partner_part">contact</field>
        <field name="note">Manufacturer Contact</field>
    </record>
    <record id="metafield_gpsr_eu_responsible" model="shopify.metafield.map">
        <field name="sequence">34</field>
        <field name="field_id" ref="field_product_template__gpsr_eu_responsible_id"/>
        <field name="key">gpsr_eu_responsible_person_name</field>
        <field name="metafield_type">single_line_text_field</field>
        <field name="partner_part">name</field>
        <field name="note">EU Responsible Person</field>
    </record>
    <record id="metafield_gpsr_eu_responsible_address" model="shopify.metafield.map">
        <field name="sequence">35</field>
        <field name="field_id" ref="field_product_template__gpsr_eu_responsible_id"/>
        <field name="key">gpsr_eu_responsible_person_address</field>
        <field name="metafield_type">multi_line_text_field</field>
        <field name="partner_part">address</field>
        <field name="note">EU Responsible Person Address</field>
    </record>
    <record id="metafield_gpsr_eu_responsible_contact" model="shopify.metafield.map">
        <field name="sequence">36</field>
        <field name="field_id" ref="field_product_template__gpsr_eu_responsible_id"/>
        <field name="key">gpsr_eu_responsible_person_electronic_address</field>
        <field name="metafield_type">single_line_text_field</field>
        <field name="partner_part">contact</field>
        <field name="note">EU Responsible Contact</field>
    </record>
    <record id="metafield_lead_time" model="shopify.metafield.map">
        <field name="sequence">40</field>
        <field name="field_id" ref="stock.field_product_template__sale_delay"/>
        <field name="key">sale_delay</field>
        <field name="metafield_type">number_integer</field>
        <field name="note">Sale Delay (days to dispatch)</field>
    </record>
    <record id="metafield_trade_note" model="shopify.metafield.map">
        <field name="sequence">41</field>
        <field name="field_id" ref="field_product_template__product_trade_note"/>
        <field name="key">product_trade_note</field>
        <field name="metafield_type">multi_line_text_field</field>
        <field name="note">Product Trade Note</field>
    </record>
    <record id="metafield_complementary" model="shopify.metafield.map">
        <field name="sequence">50</field>
        <field name="field_id" ref="sale.field_product_template__optional_product_ids"/>
        <field name="namespace">shopify--discovery--product_recommendation</field>
        <field name="key">complementary_products</field>
        <field name="metafield_type">list.product_reference</field>
        <field name="note">Search &amp; Discovery 'Goes with' products</field>
    </record>
    <record id="metafield_enable_google_shopping" model="shopify.metafield.map">
        <field name="sequence">59</field>
        <field name="field_id" ref="field_product_template__enable_google_shopping"/>
        <field name="key">enable_google_shopping</field>
        <field name="metafield_type">boolean</field>
        <field name="note">Enable Google Shopping</field>
    </record>
    <record id="metafield_google_age_group" model="shopify.metafield.map">
        <field name="sequence">60</field>
        <field name="field_id" ref="field_product_template__google_age_group"/>
        <field name="condition_field_id" ref="field_product_template__enable_google_shopping"/>
        <field name="key">google_age_group</field>
        <field name="metafield_type">single_line_text_field</field>
        <field name="note">Google Age Group</field>
    </record>
    <record id="metafield_google_gender" model="shopify.metafield.map">
        <field name="sequence">61</field>
        <field name="field_id" ref="field_product_template__google_gender"/>
        <field name="condition_field_id" ref="field_product_template__enable_google_shopping"/>
        <field name="key">google_gender</field>
        <field name="metafield_type">single_line_text_field</field>
        <field name="note">Google Gender</field>
    </record>
    <record id="metafield_google_condition" model="shopify.metafield.map">
        <field name="sequence">62</field>
        <field name="field_id" ref="field_product_template__google_condition"/>
        <field name="condition_field_id" ref="field_product_template__enable_google_shopping"/>
        <field name="key">google_condition</field>
        <field name="metafield_type">single_line_text_field</field>
        <field name="note">Google Condition</field>
    </record>
    <record id="metafield_google_mpn" model="shopify.metafield.map">
        <field name="sequence">63</field>
        <field name="field_id" ref="js_product_sku.field_product_template__sku_base"/>
        <field name="condition_field_id" ref="field_product_template__enable_google_shopping"/>
        <field name="key">google_mpn</field>
        <field name="metafield_type">single_line_text_field</field>
        <field name="note">Google MPN = SKU base</field>
    </record>
</odoo>
