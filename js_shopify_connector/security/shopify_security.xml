<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Own privilege: the Users form shows one dropdown per privilege, so sharing
         "Products" would make Shopify Manager an alternative to the SKU manager group. -->
    <record id="res_groups_privilege_shopify" model="res.groups.privilege">
        <field name="name">Shopify</field>
        <field name="description">Set up the Shopify connection: store credentials, locations, sales channels and metafields.</field>
        <field name="placeholder">No access</field>
        <field name="category_id" ref="base.module_category_master_data"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_shopify_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="comment">Sets up the Shopify connection: credentials, locations, sales channels and metafields.</field>
        <field name="implied_by_ids" eval="[Command.link(ref('base.group_system'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_shopify"/>
    </record>
</odoo>
